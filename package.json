{
  "name": "vue-cli-rspack-runner",
  "version": "0.1.0",
  "private": false,
  "description": "Run a Vue CLI 5 / Vue 3 project with Rspack without editing its configuration",
  "type": "commonjs",
  "bin": {
    "rspack-runner": "src/cli.cjs"
  },
  "scripts": {
    "demo": "bun src/cli.cjs dev --project ../assets-supervision-ui --port 8087",
    "build:executable": "bun scripts/build-executable.cjs",
    "brew:install": "bun scripts/brew.cjs install",
    "brew:update": "bun scripts/brew.cjs update",
    "brew:uninstall": "bun scripts/brew.cjs uninstall",
    "test": "bun test test/*.test.cjs",
    "test:executable": "bun scripts/test-executable.cjs",
    "test:e2e": "bun vitest --config vitest.e2e.config.mjs --run"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@rspack/core": "1.7.12",
    "@rspack/dev-server": "1.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "html-webpack-plugin": "5.6.6",
    "ink": "8.0.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "sass-embedded": "1.105.0",
    "sass-loader": "16.0.6",
    "source-map": "0.6.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5"
  }
}
