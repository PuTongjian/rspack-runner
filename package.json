{
  "name": "vue-cli-rspack-runner",
  "version": "0.1.0",
  "private": false,
  "description": "Run a Vue CLI 5 / Vue 3 project with Rspack without editing its configuration",
  "type": "commonjs",
  "bin": {
    "rspack-runner": "src/cli.cjs"
  },
  "scripts": {
    "demo": "node src/cli.cjs dev --project ../assets-supervision-ui --port 8087",
    "brew:install": "node scripts/brew.cjs install",
    "brew:update": "node scripts/brew.cjs update",
    "brew:uninstall": "node scripts/brew.cjs uninstall",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "vitest --config vitest.e2e.config.mjs --run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@rspack/core": "1.7.12",
    "@rspack/dev-server": "1.2.1",
    "html-webpack-plugin": "5.6.6",
    "sass-embedded": "1.105.0",
    "sass-loader": "16.0.6",
    "source-map": "0.6.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "devDependencies": {
    "@vitest/browser": "^5.0.5",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5"
  }
}
